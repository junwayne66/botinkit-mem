      "thresholds": {"min_independently_scored_pairs":4,"min_paired_gain_lower_bound":0.25,"max_cost_per_success":2.5,"max_forbidden_hits":0},
      "interval_rule": "每个任务代表一个独立留出任务族。对四个任务差值（候选成功指示值减基线成功指示值），穷举有放回的四次抽样，共 256 个均值。按升序取第 ceil(0.05×256) 项作为单侧 95% 下界。",
      "columns": ["task_family","baseline_verdict","candidate_verdict","candidate_cost_units","forbidden_hits"],
      "paired_holdout_log": [["a","failed","passed",2,0],["b","failed","passed",2,0],["c","failed","passed",3,0],["d","passed","passed",3,0]],
